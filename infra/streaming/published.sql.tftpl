-- updateData is not an append-only IAM permission. Recheck the independently
-- certified content at read time; a mutated selected candidate becomes invisible.
WITH leaves AS (
 SELECT candidate,tenant,body,LOWER(TO_HEX(SHA256(body))) leaf
 FROM `${project}.${output}.candidate_events` WHERE tenant='${tenant}'
), buckets AS (
 SELECT candidate,tenant,SUBSTR(leaf,1,3) bucket,COUNT(*) n,
   LOWER(TO_HEX(SHA256(STRING_AGG(leaf,'\n' ORDER BY body)))) h
 FROM leaves GROUP BY candidate,tenant,bucket
), roots AS (
 SELECT candidate,tenant,SUM(n) row_count,
   LOWER(TO_HEX(SHA256(STRING_AGG(CONCAT(bucket,':',CAST(n AS STRING),':',h),'\n' ORDER BY bucket)))) output_hash
 FROM buckets GROUP BY candidate,tenant
), certified AS (
 SELECT c.candidate,c.tenant,c.row_count,c.output_hash
 FROM `${project}.${output}.candidates` c
 JOIN `${project}.${output}.proofs` p USING(candidate,source_hash,output_hash,policy)
 WHERE c.tenant='${tenant}' AND p.verified
 GROUP BY c.candidate,c.tenant,c.row_count,c.output_hash HAVING COUNT(*)=1
)
SELECT e.candidate,e.tenant,s.lane,s.cohort,e.body
FROM `${project}.${output}.candidate_events` e
JOIN `${project}.${output}.selectors` s ON e.tenant=s.tenant AND e.candidate=s.candidate
JOIN certified c ON e.candidate=c.candidate AND e.tenant=c.tenant
JOIN roots r ON c.candidate=r.candidate AND c.tenant=r.tenant AND c.row_count=r.row_count AND c.output_hash=r.output_hash
WHERE e.tenant='${tenant}'
